{
  "name": "@urx/device-control",
  "version": "0.4.0",
  "private": true,
  "description": "Device definitions, codecs and semantic operations for YAMAHA URX series audio interfaces",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "default": "./dist/operations/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  }
}
